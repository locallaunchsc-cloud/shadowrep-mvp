# ----------------------------------------------------------------------------
# ShadowRep — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local dev. On Vercel, set the same values
# under Project Settings -> Environment Variables.
#
# The MVP runs with mock wallet analytics + in-memory proof storage, so none of
# these are strictly required for the first Vercel deploy. They become
# important once you wire up persistence and real analytics.

# HMAC secret used to sign hidden-wallet reputation proofs. REQUIRED in
# production. Generate one with:  openssl rand -hex 32
SHADOWREP_ISSUER_SECRET="change-me-before-production"

# Public app URL — used for share card links if you choose to read it
# server-side. Optional.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Helius API key. When set, /api/analyze pulls REAL on-chain stats from
# mainnet (signatures, swaps, protocols touched). When unset, the app uses
# deterministic mock data so the demo deploy still works.
# Get a free key at https://helius.dev (server-only — do NOT prefix with NEXT_PUBLIC_).
HELIUS_API_KEY=""

# Optional. Only needed when you wire Prisma to a real database. Leave unset
# for the demo deploy — nothing reads it.
# DATABASE_URL="postgresql://user:password@host:5432/shadowrep"
